{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jerseys",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "jerseys",
			"database_id": "4d824f55-f2ea-4107-9b7b-e37d362b61cb",
			"migrations_dir": "drizzle"
		},
		{
			"binding": "jerseys",
			"database_name": "jerseys",
			"database_id": "4d824f55-f2ea-4107-9b7b-e37d362b61cb",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "COVERS",
			"bucket_name": "jerseys-covers"
		},
		{
			"bucket_name": "jerseys-covers",
			"binding": "jerseys_covers",
			"remote": true
		}
	],
	// Values are not in this file: set them with `wrangler secret put` (see README).
	"secrets": {
		"required": ["OWNER_PASSWORD", "JWT_SECRET", "THESPORTSDB_KEY"]
	}
}
